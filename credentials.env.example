# NILO backend - SECRETS ONLY.
# Copy to credentials.env and fill with real values. Never commit credentials.env.
# Non-sensitive settings live in config.yaml.

# --- MongoDB ---
# Connection settings (host/port/db/users) live in config.yaml; passwords here.
# Admin password: used only at startup to provision the app user/database.
MONGODB_ADMIN_PASSWORD=upaelo
# Application user password (auto-created/updated at startup).
MONGODB_APP_PASSWORD=nilo

# --- MinIO / S3 object storage ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# base64 32-byte key backing MinIO's KMS (enables SSE-S3 at rest).
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MINIO_KMS_KEY=FmeT+45xkNWAzyQhZASnnPId+5lLQ7oXjpzC7NKTq0w=

# --- Security / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=fuf7yCGLdoNS1ZqMAoCqMD2ikzNr0BQbcbvonV06xeoR3Wc5QSBvipp_Pu0aBvFf

# --- Field-level encryption (patient data at rest) ---
# base64 master key (>= 32 bytes). LOSING THIS KEY MEANS LOSING THE DATA.
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=WdMRI7R2e0JCSJeyheftAPLAzUQSIPfTIAck31SX4CA=

# --- Bootstrap root user (auto-created on first startup) ---
ROOT_EMAIL=root@niloai.net
ROOT_PASSWORD=root

# --- Seed users (auto-created at startup when SEED_USERS=true; also used by
# scripts/seed_users.sh) ---
SEED_CLINICIAN_EMAIL=clinician@niloai.net
SEED_CLINICIAN_PASSWORD=clinician
SEED_PATIENT_EMAIL=patient@niloai.net
SEED_PATIENT_PASSWORD=patient
