# Copia a credentials.env y rellena. No versionar credentials.env.

# IP del host donde están Mongo y MinIO (vista desde esta VM/máquina).
NILO_INFRA_HOST=192.168.1.10
# URLs presignadas MinIO para clientes (nilo-node); suele ser la misma IP accesible en LAN.
MINIO_PUBLIC_HOST=192.168.1.10

MONGODB_ADMIN_USER=admin
MONGODB_ADMIN_PASSWORD=cambiar
MONGODB_APP_PASSWORD=cambiar

MINIO_ACCESS_KEY=cambiar
MINIO_SECRET_KEY=cambiar
MINIO_KMS_KEY=

JWT_SECRET_KEY=cambiar
ENCRYPTION_MASTER_KEY=cambiar

ROOT_EMAIL=root@example.com
ROOT_PASSWORD=cambiar
SEED_USERS=false

# Opcional: fijar tag concreto
# NILO_API_IMAGE=ghcr.io/neovisionsai/nilo-backend:abc1234
