[Unit]
Description=NILO backend API (Docker Compose)
Documentation=file://@INSTALL_DIR@/docs/05.vm_systemd_service.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
Environment=NILO_CREDENTIALS_FILE=@INSTALL_DIR@/credentials.env
User=@SERVICE_USER@
Group=docker
# compose up en primer plano: systemd queda active (running) y reinicia si el proceso cae.
ExecStart=/bin/sh -c '@DOCKER_COMPOSE@ -f @COMPOSE_FILE@ @COMPOSE_EXTRA@ --env-file @INSTALL_DIR@/credentials.env up --remove-orphans'
ExecStop=/bin/sh -c '@DOCKER_COMPOSE@ -f @COMPOSE_FILE@ @COMPOSE_EXTRA@ --env-file @INSTALL_DIR@/credentials.env down'
ExecReload=/bin/sh -c '@DOCKER_COMPOSE@ -f @COMPOSE_FILE@ @COMPOSE_EXTRA@ --env-file @INSTALL_DIR@/credentials.env up -d --build --remove-orphans'
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
